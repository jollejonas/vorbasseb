# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vorbassebk

# NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_YEARLY=price_...

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@vorbassebk.dk
ADMIN_EMAIL=admin@vorbassebk.dk

# Cloudinary (public, safe to expose)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_UPLOAD_PRESET=your-upload-preset

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DBU API
DBU_API_KEY=your-dbu-api-key

# Cron jobs (set a strong random secret, and set the same value in Vercel env vars)
# Required in Vercel Production for /api/cron/* authorization.
CRON_SECRET=generate-with-openssl-rand-hex-32
