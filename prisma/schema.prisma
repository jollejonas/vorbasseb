generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js (NextAuth v5) required models ────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  customerNumber        Int       @default(autoincrement())
  role                  Role      @default(CUSTOMER)
  clubRole              ClubRole  @default(NONE)
  newsletterConsent     Boolean   @default(false)
  newsletterConsentAt   DateTime?
  firstName             String?
  lastName              String?
  phone                 String?
  birthDate             DateTime?
  addressLine1          String?
  addressLine2          String?
  postalCode            String?
  city                  String?
  country               String?   @default("DK")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  cart            Cart?
  orders          Order[]
  addresses       Address[]
  subscription    Subscription?
  grantsReceived  TrainerGrant[] @relation("TrainerGrantReceiver")
  grantsGiven     TrainerGrant[] @relation("TrainerGrantGiver")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ───────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum ClubRole {
  NONE
  PLAYER
  TRAINER
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  status               SubStatus
  plan                 Plan
  currentPeriodEnd     DateTime
  createdAt            DateTime  @default(now())
}

enum SubStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum Plan {
  MONTHLY
  YEARLY
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  position Int
  products Product[]

  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")

  @@index([position])
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  description      String      @db.Text
  categoryId       String?
  category         Category?   @relation(fields: [categoryId], references: [id])
  price            Int // øre (DKK × 100)
  salePrice        Int?        // øre — tilbudspris (ekskl. moms, som price)
  salePriceStart   DateTime?   // tilbud gælder fra (inklusiv)
  salePriceEnd     DateTime?   // tilbud gælder til (inklusiv)
  modelNumber      String?     // e.g. "2001" — used in varenummer auto-generation
  membersOnly             Boolean     @default(false)
  membersEarlyAccess      Boolean     @default(false)
  clubRoleRequired        ClubRole?
  published            Boolean     @default(true)
  featured             Boolean     @default(false)
  images           String[] // Cloudinary URLs (used when no color variants)
  // Samlebestilling (group order)
  isGroupOrder          Boolean   @default(false)
  groupOrderDeadline    DateTime?
  // Jersey designer
  designerEnabled       Boolean  @default(false)
  designerFrontImageIdx Int?     // index into images[] for front preview
  designerBackImageIdx  Int?     // index into images[] for back preview
  designerPrintColor    String?  // hex color for print text overlay, e.g. "#FFFFFF"
  skus             SKU[]
  colorVariants    ColorVariant[]
  optionGroups     ProductOptionGroup[]
  designerZones    DesignerZone[]
  heroSlides       HeroSlide[]
  trainerGrants    TrainerGrant[]
  pakketilbudItems PakketilbudItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Pakketilbud {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String            @default("")
  price          Int               // base price in øre
  salePrice      Int?              // øre — tilbudspris
  salePriceStart DateTime?         // tilbud gælder fra (inklusiv)
  salePriceEnd   DateTime?         // tilbud gælder til (inklusiv)
  images      String[]
  published   Boolean           @default(true)
  featured    Boolean           @default(false)
  position    Int               @default(0)
  items       PakketilbudItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model PakketilbudItem {
  id            String      @id @default(cuid())
  pakketilbudId String
  pakketilbud   Pakketilbud @relation(fields: [pakketilbudId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  position      Int         @default(0)
  label         String?

  @@index([pakketilbudId, position])
}

model GlobalColor {
  id                   String                    @id @default(cuid())
  name                 String                    // "Rød"
  hex                  String                    // "#CC0000"
  code                 String                    @unique // "03" — used in varenummer
  position             Int                       @default(0)
  optionValues         ProductOptionValue[]
  optionTemplateValues OptionGroupTemplateValue[]

  @@index([position])
}

enum ProductOptionType {
  COLOR
  SIZE
  TEXT
  SELECT
  CUSTOM
}

model ProductOptionGroup {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductOptionType
  label     String
  position  Int                 @default(0)
  required  Boolean             @default(false)
  fee       Int?                // øre — TEXT/CUSTOM only
  costFee   Int?                // øre, ekskl. moms — kostpris for TEXT/CUSTOM tilvalg
  inputType String?             // "text"|"number"|"checkbox"|"dropdown" — CUSTOM only
  values    ProductOptionValue[]

  @@index([productId, position])
}

model ProductOptionValue {
  id            String              @id @default(cuid())
  groupId       String
  group         ProductOptionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label         String
  position      Int                 @default(0)
  globalColorId String?
  globalColor   GlobalColor?        @relation(fields: [globalColorId], references: [id], onDelete: SetNull)
  images        String[]            // Cloudinary URLs — COLOR type only
  imageLabels   String[]            // optional labels for images[], index-aligned (e.g. "Forside", "Bagside")
  price         Int?                // øre, ekskl. moms — SELECT type only
  costPrice     Int?                // øre, ekskl. moms — SELECT type only
  // Designer canvas overrides — COLOR type only (optional)
  designerFrontImageIdx Int?        // index into images[] to use as front canvas template
  designerBackImageIdx  Int?        // index into images[] to use as back canvas template
  designerPrintColor    String?     // hex e.g. "#FFFFFF" — overrides product.designerPrintColor
  skuValues     SKUOptionValue[]

  @@index([groupId, position])
}

model SKUOptionValue {
  skuId         String
  sku           SKU                @relation(fields: [skuId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([skuId, optionValueId])
  @@index([optionValueId])
}

// ─── Global option group template library ─────────────────────────────────

model OptionGroupTemplate {
  id        String                     @id @default(cuid())
  name      String                     // "Voksen tøjstørrelser", "Sko EU størrelser"
  type      ProductOptionType
  tags      String[]                   // ["Tøj", "Sport"] — free-form, multiple
  required  Boolean                    @default(false)
  fee       Int?                       // øre — TEXT/CUSTOM only
  inputType String?                    // "text"|"number"|"checkbox"|"dropdown" — CUSTOM only
  position  Int                        @default(0)
  values    OptionGroupTemplateValue[]
  createdAt DateTime                   @default(now())

  @@index([type])
}

model OptionGroupTemplateValue {
  id            String              @id @default(cuid())
  templateId    String
  template      OptionGroupTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label         String
  position      Int                 @default(0)
  globalColorId String?
  globalColor   GlobalColor?        @relation(fields: [globalColorId], references: [id], onDelete: SetNull)
  images        String[]

  @@index([templateId, position])
}

model ColorVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Rød/Hvid"
  hex       String   // e.g. "#CC0000" — swatch color
  images    String[] // Cloudinary URLs for this color
  position  Int      @default(0)
  skus      SKU[]
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model SKU {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorVariantId String?
  colorVariant   ColorVariant? @relation(fields: [colorVariantId], references: [id], onDelete: Cascade)
  size           String // "XS","S","M","L","XL","XXL","116","128","140","152","164"
  stock          Int           @default(0)
  itemNumber     String?       // varenummer
  itemNumberOverride Boolean   @default(false) // true = never auto-overwrite
  costPrice      Int?          // øre, ekskl. moms — kostpris pr. SKU
  optionValues   SKUOptionValue[]
  orderItems     OrderItem[]
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     Int            @default(autoincrement())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  guestEmail      String?
  status          OrderStatus    @default(PENDING)
  deliveryMethod  DeliveryMethod @default(SHIPPING)
  stripeSessionId String?        @unique
  stripePaymentId String?
  total           Int // øre
  discountApplied Int            @default(0) // øre
  shippingFee     Int // øre
  trackingNumber  String?
  customerName    String?
  phone           String?
  refunded        Boolean        @default(false)
  cancelledAt     DateTime?
  groupOrderHoldUntil DateTime?  // hold order until this date (group order snapshot)
  items           OrderItem[]
  usedGrants      TrainerGrant[]
  addressId       String?
  shippingAddress Address?       @relation(fields: [addressId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model TrainerGrant {
  id          String             @id @default(cuid())
  userId      String
  productId   String
  grantedById String
  status      TrainerGrantStatus @default(PENDING)
  orderId     String?
  createdAt   DateTime           @default(now())

  user      User    @relation("TrainerGrantReceiver", fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("TrainerGrantGiver", fields: [grantedById], references: [id])
  order     Order?  @relation(fields: [orderId], references: [id])

  @@index([userId, status])
  @@index([productId])
}

enum TrainerGrantStatus {
  PENDING
  USED
  REVOKED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  AWAITING_PICKUP
  PICKUP_READY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryMethod {
  SHIPPING
  PICKUP
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId            String?
  sku              SKU?    @relation(fields: [skuId], references: [id], onDelete: SetNull)
  quantity         Int
  priceAtPurchase  Int // øre
  customName       String?
  customNumber     String?
  colorName        String? // stored at purchase for historical accuracy
  optionSelections Json    @default("[]") // snapshot of TEXT/SELECT/CUSTOM selections
}

model Address {
  id       String  @id @default(cuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  name     String
  line1    String
  line2    String?
  city     String
  postcode String
  country  String  @default("DK")
  orders   Order[]
}

model NewsPost {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String      @db.Text
  coverImage  String?
  membersOnly Boolean     @default(false)
  publishedAt DateTime?
  heroSlides  HeroSlide[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── Jersey designer ───────────────────────────────────────────────────────

model DesignerZone {
  id          Int           @id @default(autoincrement())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  side        String        // "front" | "back"
  label       String        // e.g. "Ryg øverst", "Bryst venstre"
  position    String        // "top-left" | "top-center" | etc.
  allowText   Boolean       @default(true)
  allowLogo   Boolean       @default(false)
  price       Int           @default(0) // price in øre (added on top of product price per zone)
  tipText     String?       // hint shown to customer when zone is selected
  fixedLogoId Int?          // if set, zone is hidden from customer; logo always applied
  fixedLogo   DesignerLogo? @relation(fields: [fixedLogoId], references: [id], onDelete: SetNull)
  previewX    Float         @default(10) // % from left (top-left corner)
  previewY    Float         @default(10) // % from top (top-left corner)
  previewW    Float         @default(20) // % width
  previewH    Float         @default(15) // % height
  positionOrd Int           @default(0)

  @@index([productId, positionOrd])
}

model DesignerLogo {
  id       Int           @id @default(autoincrement())
  name     String
  imageUrl String
  isClub   Boolean       @default(false)
  zones    DesignerZone[]
}

// ─── Site configuration ────────────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum SlideType {
  CUSTOM
  LATEST_NEWS
  LATEST_PRODUCT
}

model HeroSlide {
  id             String    @id @default(cuid())
  type           SlideType
  position       Int
  enabled        Boolean   @default(true)

  // CUSTOM slide fields
  heading        String?
  subheading     String?
  body           String?   @db.Text
  imageUrl       String?
  ctaLabel       String?
  ctaHref        String?
  overlayOpacity Int       @default(40) // 0–100
  newsCount      Int       @default(1)  // LATEST_NEWS: how many news posts to show as separate slides (1–5)

  // Optional pin overrides for LATEST_NEWS / LATEST_PRODUCT
  overrideNewsId    String?
  overrideNews      NewsPost? @relation(fields: [overrideNewsId], references: [id], onDelete: SetNull)
  overrideProductId String?
  overrideProduct   Product?  @relation(fields: [overrideProductId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model NewsletterSubscriber {
  email     String   @id
  createdAt DateTime @default(now())
}

// ─── Sports ticker ─────────────────────────────────────────────────────────

model FootballTeam {
  id           String      @id @default(cuid())
  name         String      @unique
  logo         String?     // URL (e.g. from DBU website)
  defaultVenue String?
  homeMatches  ClubMatch[] @relation("HomeTeam")
  awayMatches  ClubMatch[] @relation("AwayTeam")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ClubMatch {
  id         String        @id @default(cuid())
  clubTeam   String        // "Herrer" | "Damer" | "Herrer2"
  isUpcoming Boolean       // true = next game, false = latest result
  league     String        @default("")
  matchDate  DateTime?
  homeTeamId String?
  homeTeam   FootballTeam? @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  homeScore  Int?          // null for upcoming
  awayTeamId String?
  awayTeam   FootballTeam? @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  awayScore  Int?          // null for upcoming
  venue      String        @default("")
  enabled    Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([clubTeam, isUpcoming])
}

// ─── DBU API cache ──────────────────────────────────────────────────────────

model DbuTeamConfig {
  id         String        @id @default(cuid())
  label      String        // Admin-editable display name, e.g. "Herrer"
  teamId     Int           // DBU TeamId
  poolId     Int           // DBU PoolId
  rowName    String        // e.g. "Herrer Serie 4 - Forår 2026" (from API)
  enabled    Boolean       @default(true)
  lastSyncAt DateTime?
  matches    DbuMatch[]
  standings  DbuStanding[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([teamId, poolId])
}

model DbuMatch {
  id            String        @id @default(cuid())
  dbuId         Int           @unique // DBU Match.Id
  configId      String
  config        DbuTeamConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  matchDateTime DateTime
  roundNo       Int
  homeTeamName  String
  homeScore     Int?          // null = not played yet
  awayTeamName  String
  awayScore     Int?
  stadiumName   String
  updatedAt     DateTime      @updatedAt
}

model DbuStanding {
  id           String        @id @default(cuid())
  configId     String
  config       DbuTeamConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  sort         Int
  teamName     String
  isClubTeam   Boolean
  noOfMatch    Int
  matchWon     Int
  matchDrawn   Int
  matchLost    Int
  score        Int
  scoreAgainst Int
  point        Int
  updatedAt    DateTime      @updatedAt

  @@unique([configId, sort])
}

// ─── Configurable sizes ─────────────────────────────────────────────────────

model SizePreset {
  id       String @id @default(cuid())
  label    String @unique
  position Int    @default(0)

  @@index([position])
}

// ─── Admin invite tokens ────────────────────────────────────────────────────

model AdminInviteToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Sponsors ───────────────────────────────────────────────────────────────

model Sponsor {
  id         String  @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String?
  position   Int     @default(0)

  @@index([position])
}
